<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/default_padding">

        <!-- 应用标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/main_title"
            android:textSize="24sp"
            android:textColor="#000000"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/main_subtitle"
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:paddingBottom="24dp" />

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#000000"
            android:layout_marginBottom="16dp" />

        <!-- 状态信息 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/system_status"
            android:textSize="18sp"
            android:textColor="#000000"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <!-- 权限状态 -->
        <!-- 已删除权限状态检查中...的TextView和相关布局 -->

        <!-- Storage Permission Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">
            <TextView
                android:id="@+id/tvStoragePermissionStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/storage_permission_status_unknown"
                android:textSize="16sp"
                android:textColor="#333333"
                android:lineSpacingExtra="8dp" />
            <Button
                android:id="@+id/btnRequestStoragePermission"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/request_storage_permission"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- iReader Directory Permission Status (Only for iReader devices) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">
            <TextView
                android:id="@+id/tvIReaderDirectoryStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/device_screenshot_path_unknown"
                android:textSize="16sp"
                android:textColor="#333333"
                android:lineSpacingExtra="8dp"
                android:visibility="gone" />
            <Button
                android:id="@+id/btnRequestIReaderDirectory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/configure_permission"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Accessibility Permission Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">
            <TextView
                android:id="@+id/tvAccessibilityPermissionStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/accessibility_permission_unknown"
                android:textSize="16sp"
                android:textColor="#333333"
                android:lineSpacingExtra="8dp" />
            <Button
                android:id="@+id/btnRequestAccessibilityPermission"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/grant_accessibility_permission"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- 截屏权限管理 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tvScreenshotStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/screenshot_permission_checking"
                android:textSize="16sp"
                android:textColor="#333333"
                android:lineSpacingExtra="8dp" />

            <Button
                android:id="@+id/btnScreenshotPermission"
                android:layout_width="120dp"
                android:layout_height="32dp"
                android:text="@string/grant_screenshot_permission"
                android:textSize="12sp"
                android:textColor="#000000"
                android:background="#F0F0F0" />

        </LinearLayout>

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#000000"
            android:layout_marginBottom="16dp" />

        <!-- 统计信息 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/usage_statistics"
            android:textSize="18sp"
            android:textColor="#000000"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/tvStatistics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/loading"
            android:textSize="14sp"
            android:textColor="#333333"
            android:paddingBottom="16dp" />

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#000000"
            android:layout_marginBottom="16dp" />

        <!-- 功能按钮 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/function_menu"
            android:textSize="18sp"
            android:textColor="#000000"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <!-- 悬浮窗服务管理 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvFloatingWindowStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/floating_service_status_checking"
                android:textSize="14sp"
                android:textColor="#333333" />

            <Button
                android:id="@+id/btnFloatingWindow"
                android:layout_width="120dp"
                android:layout_height="32dp"
                android:text="@string/start_floating"
                android:textSize="12sp"
                android:textColor="#000000"
                android:background="#F0F0F0" />

        </LinearLayout>

        <!-- 截屏自动弹窗设置 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/auto_screenshot_trigger"
                android:textSize="14sp"
                android:textColor="#333333" />

            <Switch
                android:id="@+id/switchScreenshotAutoPopup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />

        </LinearLayout>

        <!-- AI平台状态和设置入口（下移到此处） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tvApiKeyStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/api_key_status_checking"
                android:textSize="14sp"
                android:textColor="#333333" />

            <Button
                android:id="@+id/btnApiKey"
                android:layout_width="120dp"
                android:layout_height="32dp"
                android:text="@string/set_api_key"
                android:textSize="12sp"
                android:textColor="#000000"
                android:background="#F0F0F0" />

        </LinearLayout>

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="@string/settings"
            android:textSize="16sp"
            android:textColor="#000000"
            android:background="#F5F5F5"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnHistory"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="@string/history"
            android:textSize="16sp"
            android:textColor="#000000"
            android:background="#F5F5F5"
            android:layout_marginBottom="8dp" />



        <!-- 危险操作区域 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#000000"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/data_management"
            android:textSize="18sp"
            android:textColor="#000000"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <Button
            android:id="@+id/btnClearData"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="@string/clear_data_title"
            android:textSize="16sp"
            android:textColor="#666666"
            android:background="#F0F0F0"
            android:layout_marginBottom="16dp" />

    </LinearLayout>

</ScrollView> 